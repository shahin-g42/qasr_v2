{
  "train_cache": "../../data/speaker-train-cache",
  "validation_cache": "../../data/speaker-val-cache",
  "output_dir": "../outputs/arabic",
  "qwen": "../../models/qwen-tts",
  "speaker_checkpoint": "../outputs/speaker/last.pt",
  "batch_size": 2,
